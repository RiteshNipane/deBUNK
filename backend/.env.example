# Copy this file to .env and fill in your own keys (never commit .env) and load it into the environment. Everything is optional for local dev:
#  - no LLM -> heuristic claim extraction + keyword-overlap stance (much weaker, results marked "degraded")
#  - no FACTCHECK_API_KEY / GNEWS_API_KEY -> those sources are skipped (Google News RSS search and the RSS feeds still work, no keys needed)

# ---- LLM (pick ONE). Used for claim extraction and for judging whether articles support/contradict a claim.
# Free options: gemini (aistudio.google.com/apikey), groq (console.groq.com/keys), openrouter (":free" models),
# ollama (local, no key). Paid: anthropic. Free-tier limits and model names change: override LLM_MODEL if one is retired.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=            # only for provider "openai-compatible" (or to override a preset)
# Old setting still works: ANTHROPIC_API_KEY=... (provider defaults to anthropic)

# ---- Backup LLM (strongly recommended: Gemini's free tier often answers 503 busy / 429 rate limit).
# Leave LLM2_API_KEY empty to run without a backup.
LLM2_PROVIDER=gemini
LLM2_API_KEY=
LLM2_MODEL=gemini-flash-latest

FACTCHECK_API_KEY=
# GNews is optional and off by default (free plan is non-commercial and rate-limited).
GNEWS_API_KEY=
# GDELT is free but rate-limited (~1 request / 5 s). Set to 1 once you have a paid news API.
DISABLE_GDELT=1
DISABLE_RSS=
# Shared secret the Android app sends as X-API-Key. Empty = no auth (local dev only).
BACKEND_API_KEY=

# Dev only: log the exact text the app sends (remove when done testing)
# DEBUG_LOG_TEXT=1

# ---- Free plan: scans per device per day (0 = unlimited). Premium devices are unlimited.
FREE_DAILY_LIMIT=10
# Where the counters are kept. Use a persistent path in production, or counts reset on every restart.
# QUOTA_DB=/var/data/quota.db
# Day boundary shift from UTC in minutes (330 = India midnight).
# QUOTA_RESET_OFFSET_MIN=330
# Testing premium: comma-separated device ids, or set ADMIN_KEY and POST /v1/admin/premium (see README).
# PREMIUM_DEVICE_IDS=
# ADMIN_KEY=choose-a-long-random-string
